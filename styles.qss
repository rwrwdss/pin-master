/* Строгая бело-черная тема для PinMaster - инструмент */

/* Основные цвета */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 11px;
}

QMainWindow {
    background-color: #ffffff;
}

/* Сайдбар - минималистичный дизайн */
QWidget#sidebar {
    background-color: #fafafa;
    border-right: 1px solid #e8e8e8;
    min-width: 250px;
}

QPushButton#sidebarButton {
    background-color: transparent;
    border: none;
    text-align: left;
    padding: 8px 16px;
    border-radius: 4px;
    color: #1a1a1a;
    font-weight: 500;
    font-size: 11px;
}

QPushButton#sidebarButton:hover {
    background-color: #e8e8e8;
}

QPushButton#sidebarButton:pressed {
    background-color: #d0d0d0;
}

QPushButton#sidebarButton:checked {
    background-color: #000000;
    color: #ffffff;
    font-weight: 600;
}

/* Кнопки - минималистичный дизайн */
QPushButton {
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
    font-size: 11px;
    min-height: 32px;
    letter-spacing: 0.2px;
}

QPushButton:hover {
    background-color: #1a1a1a;
}

QPushButton:pressed {
    background-color: #000000;
}

QPushButton:disabled {
    background-color: #f5f5f5;
    color: #999999;
    border: none;
}

/* Вторичные кнопки */
QPushButton#secondaryButton {
    background-color: transparent;
    color: #1a1a1a;
    border: 1px solid #e0e0e0;
}

QPushButton#secondaryButton:hover {
    background-color: #f5f5f5;
    border-color: #000000;
}

/* Компактные кнопки */
QPushButton#compactButton {
    padding: 4px 10px;
    min-height: 24px;
    font-size: 10px;
}

/* Поля ввода - минималистичный дизайн */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1a1a1a;
    font-size: 11px;
    selection-background-color: #000000;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #000000;
    outline: none;
    background-color: #fafafa;
}

QLineEdit:hover, QTextEdit:hover {
    border-color: #b0b0b0;
}

/* Группы - минималистичный дизайн */
QGroupBox {
    background-color: transparent;
    border: none;
    border-radius: 0;
    margin-top: 0;
    padding-top: 0;
    font-weight: 600;
    font-size: 9px;
    color: #666666;
    letter-spacing: 0.3px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    padding: 0 0 8px 0;
    background-color: transparent;
    color: #666666;
    border-bottom: 1px solid #e0e0e0;
    padding-bottom: 6px;
    margin-bottom: 12px;
}

/* Метки */
QLabel {
    color: #1a1a1a;
    font-size: 11px;
}

/* Текстовая область результатов */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 16px;
    color: #1a1a1a;
    line-height: 1.5;
}

/* Статус бар */
QStatusBar {
    background-color: #f5f5f5;
    border-top: 1px solid #e0e0e0;
    color: #666666;
    padding: 8px;
}

/* Меню */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    color: #1a1a1a;
    padding: 4px;
}

QMenuBar::item {
    padding: 8px 16px;
    border-radius: 4px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #f0f0f0;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 8px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 4px;
    color: #1a1a1a;
}

QMenu::item:selected {
    background-color: #000000;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e0e0e0;
    margin: 4px 8px;
}

/* Скроллбары */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 12px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #f5f5f5;
    height: 12px;
    border: none;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #c0c0c0;
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #a0a0a0;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Центральная область */
QWidget#centralArea {
    background-color: #ffffff;
    padding: 20px;
}

/* ComboBox */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1a1a1a;
    min-width: 100px;
    font-size: 11px;
}

QComboBox:hover {
    border-color: #b0b0b0;
}

QComboBox:focus {
    border: 2px solid #000000;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #1a1a1a;
    width: 0;
    height: 0;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    color: #1a1a1a;
    selection-background-color: #000000;
    selection-color: #ffffff;
}

/* SpinBox */
QSpinBox {
    background-color: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    padding: 6px 10px;
    color: #1a1a1a;
    font-size: 11px;
}

QSpinBox:focus {
    border: 2px solid #000000;
}

QSpinBox:hover {
    border-color: #b0b0b0;
}

/* ProgressBar */
QProgressBar {
    background-color: #f0f0f0;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    text-align: center;
    color: #1a1a1a;
    height: 24px;
}

QProgressBar::chunk {
    background-color: #000000;
    border-radius: 4px;
}

/* Dialog */
QDialog {
    background-color: #ffffff;
}

/* ListWidget */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    color: #1a1a1a;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #f0f0f0;
}

QListWidget::item:selected {
    background-color: #000000;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #f5f5f5;
}

/* CheckBox */
QCheckBox {
    color: #1a1a1a;
    font-size: 10px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #666666;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #000000;
    border-color: #000000;
}

QCheckBox::indicator:hover {
    border-color: #000000;
}

QCheckBox::indicator:disabled {
    background-color: #f0f0f0;
    border-color: #d0d0d0;
}
